{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npm --prefix server ci",
  "buildCommand": "node tools/build-cloud.cjs",
  "outputDirectory": "public",
  "functions": {
    "api/handler.js": {
      "maxDuration": 300,
      "includeFiles": "server/**",
      "excludeFiles": "{server/data/**,server/node_modules/@ffprobe-installer/win32-*/**,server/node_modules/@ffprobe-installer/darwin-*/**,server/node_modules/@electric-sql/**,server/node_modules/esbuild/**,server/node_modules/@esbuild/**}"
    }
  },
  "rewrites": [
    {"source":"/api/:path*","destination":"/api/handler?__na_path=:path*"},
    {"source":"/","destination":"/home.html"}
  ],
  "headers": [
    {"source":"/(.*)","headers":[
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"X-Frame-Options","value":"SAMEORIGIN"},
      {"key":"Referrer-Policy","value":"no-referrer"},
      {"key":"Permissions-Policy","value":"camera=(), microphone=(self), geolocation=()"},
      {"key":"Content-Security-Policy","value":"default-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; connect-src 'self' https://*.blob.vercel-storage.com https://blob.vercel-storage.com; frame-ancestors 'self'"}
    ]},
    {"source":"/(.*).html","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]}
  ]
}
