{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.9.0",
      "config": {
        "excludeFiles": [
          ".git/**",
          ".github/**",
          ".tools/**",
          ".env*",
          "node_modules/**",
          "server/**",
          "tests/**",
          "storage/**",
          "dist/**",
          "resources/js/**",
          "resources/css/**",
          "public/build/assets/**",
          "docs/**"
          ,"supabase/**"
        ]
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/build/assets/(.*)",
      "headers": {
        "Cache-Control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/prune",
      "schedule": "0 4 * * *"
    }
  ]
}
