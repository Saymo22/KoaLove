APP_NAME="KoaLove"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=projeto_na
DB_USERNAME=nossoamor
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Somente desenvolvimento; bloqueado em APP_ENV=production.
SIMULATED_PAYMENTS=false
GIFT_PRICE_CENTS=1990
FFPROBE_PATH=ffprobe
PRIVACY_EMAIL=
PRIVACY_CONTROLLER=

# Adapter S3/R2 opcional para uma decisão futura; não usado com FILESYSTEM_DISK=local.
AWS_ENDPOINT=
AWS_SESSION_TOKEN=
MEDIA_UPLOAD_ORIGINS=
# Segredo aleatório de pelo menos 32 caracteres para o cron
CRON_SECRET=

# SEO: indexação habilitada por padrão somente em produção; prévias Vercel são bloqueadas.
# Descomente para desativar a indexação no domínio de produção:
# SEO_INDEXING_ENABLED=false
# Pesquisa por OAI-SearchBot é permitida nas páginas públicas; treinamento é separado.
SEO_ALLOW_GPTBOT_TRAINING=false

# Mídias locais privadas. Em branco, usa storage/app/private.
# Em um servidor com volume persistente, pode apontar para /dados/nosso-amor/private.
# MEDIA_STORAGE_PATH=

# Supabase: somente no backend. Nunca prefixar segredos com VITE_.
# Use DB_URL do Transaction pooler (6543), DB_SSLMODE=require e estas opções:
# DB_SCHEMA=app_private
# DB_EMULATE_PREPARES=true
# FILESYSTEM_DISK=supabase
SUPABASE_REGION=us-east-1
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=gift-media
# Limite compatível com o plano Free; aumente somente após mudar o limite no provedor.
SUPABASE_STORAGE_MAX_FILE_BYTES=50000000

# Use pix_manual para chave Pix com conferência pelo admin; veja docs/PIX_MANUAL.md.
# Mercado Pago é opcional; segredos somente no backend/Vercel.
PAYMENT_GATEWAY=none
PIX_KEY=
PIX_RECEIVER_NAME=
PIX_RECEIVER_CITY=
PAYMENTS_ENABLED=false
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# Testes reais do provedor exigem credenciais/contas de teste e banco isolado.
MERCADO_PAGO_LIVE_MODE=true

# Google OpenID Connect: callback cadastrado exatamente no OAuth Client do Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback
# Inclua IDs de cliente de todas as plataformas que usam o mesmo stream RISC, separados por vírgula.
GOOGLE_CLIENT_IDS=${GOOGLE_CLIENT_ID}
