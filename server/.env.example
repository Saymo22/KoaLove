# Copie os valores para as variáveis de ambiente do processo Node.
# O servidor não carrega arquivos .env automaticamente.
PUBLIC_ORIGIN=https://seu-dominio.com
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Nosso Amor <contato@seu-dominio.com>
# Deixe vazio ao servir diretamente. Informe somente IPs de proxies confiáveis.
TRUSTED_PROXIES=
