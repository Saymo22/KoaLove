# Copie os valores para as variáveis de ambiente do processo Node.
# O servidor não carrega arquivos .env automaticamente.
PUBLIC_ORIGIN=https://seu-dominio.com
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Nosso Amor <contato@seu-dominio.com>
# Deixe vazio ao servir diretamente. Informe somente IPs de proxies confiáveis.
TRUSTED_PROXIES=

# Vercel: conecte PostgreSQL e Blob com acesso PRIVATE ao mesmo projeto.
# NA_STORAGE é automático na Vercel. Defina postgres apenas para testar nuvem localmente.
# NA_STORAGE=postgres
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
# Administrador inicial: e-mail explícito e senha exclusiva de pelo menos 12 caracteres.
# Defina nas variáveis protegidas da Vercel, nunca no repositório.
ADMIN_EMAIL=
ADMIN_PASS=
